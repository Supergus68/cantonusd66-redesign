---
---

<section id="board" class="board-section">
  <div class="container">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 3rem;">
      <span class="section-badge">District Governance & Leadership</span>
      <h2 class="section-heading">Board of Education & Administration</h2>
      <p class="section-sub" style="margin-left: auto; margin-right: auto;">
        Dedicated to serving Fulton County with fiscal responsibility, high academic standards, and open community communication.
      </p>
    </div>

    <div class="board-overview-grid">
      <!-- Superintendent Message -->
      <div class="board-leadership-card">
        <div class="leadership-tag">District Leadership</div>
        <h3 class="superintendent-name">Tad DeRenzy</h3>
        <div class="superintendent-title">Superintendent of Schools · Canton Union School District #66</div>
        <p class="superintendent-quote">
          "It is my honor and privilege to serve our community as superintendent. Canton is my hometown and I am a proud graduate of Canton High School. We are dedicated to continuing the district's rich history of providing strong academic programs and extra-curricular opportunities that give all students the tools to reach their goals."
        </p>

        <div style="font-size: 0.85rem; color: #E9D5FF; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1rem; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.4rem;">
          <div>🏢 <strong>District Office:</strong> 20 West Walnut Street, Canton, IL 61520</div>
          <div>📞 <strong>Phone:</strong> (309) 647-9411 · <strong>Fax:</strong> (309) 647-9464</div>
          <div>👥 <strong>Assistant Superintendents:</strong> Jeff Utsinger & Julie Tarvin</div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/policies" class="btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
            📜 Browse District Policies
          </a>
          <a href="https://www.cantonusd.org/budget-and-contracts.html" target="_blank" rel="noopener" class="btn-secondary" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
            📊 Budget & Financial Reports ↗
          </a>
        </div>
      </div>

      <!-- Board Roster & Meetings -->
      <div>
        <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-lg); padding: 1.75rem; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <span>🏛️</span> Board of Education Members
          </h3>
          <p style="font-size: 0.8125rem; color: var(--slate-500); margin-bottom: 1.25rem;">
            Seven elected community trustees serving non-partisan terms.
          </p>

          <div class="roster-grid">
            <div class="roster-box">
              <div class="roster-role">President</div>
              <div class="roster-name">Mike Krulac</div>
              <div class="roster-term">Term: 2019 – 2027</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Vice President</div>
              <div class="roster-name">Jorden Stanley</div>
              <div class="roster-term">Term: 2023 – 2029</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Secretary</div>
              <div class="roster-name">Brent Parry</div>
              <div class="roster-term">Term: 2023 – 2029</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Board Member</div>
              <div class="roster-name">Holly Blue</div>
              <div class="roster-term">Term: 2025 – 2027</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Board Member</div>
              <div class="roster-name">Anne Grzanich</div>
              <div class="roster-term">Term: 2023 – 2029</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Board Member</div>
              <div class="roster-name">Matt Kees</div>
              <div class="roster-term">Term: 2014 – 2027</div>
            </div>
            <div class="roster-box">
              <div class="roster-role">Board Member</div>
              <div class="roster-name">Brian Spiva</div>
              <div class="roster-term">Term: 2025 – 2031</div>
            </div>
          </div>
        </div>

        <!-- Meeting Schedule Card -->
        <div style="background: var(--white); border: 2px solid var(--cusd-gold); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
          <div style="font-size: 0.75rem; font-weight: 800; color: var(--cusd-purple); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.25rem;">
            Public Meetings & Agendas
          </div>
          <h4 style="font-size: 1.05rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem;">
            Regular Monthly Meeting Schedule
          </h4>
          <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1rem; line-height: 1.5;">
            Meetings are held on the <strong>3rd Monday of every month at 7:00 PM</strong> in the Canton High School Library (1001 N. Main St.). Open to the public pursuant to the Illinois Open Meetings Act.
          </p>
          <div style="display: flex; gap: 0.75rem;">
            <a href="https://www.cantonusd.org/board-of-education-meetings.html" target="_blank" rel="noopener" class="btn-policy-link" style="font-size: 0.8125rem;">
              📅 Meeting Agendas & Minutes ↗
            </a>
            <a href="/policies#policyQueryInput" class="btn-policy-ext" style="font-size: 0.8125rem;">
              Policy 2:230 (Public Participation) &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
