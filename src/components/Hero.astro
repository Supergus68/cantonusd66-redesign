---
---

<section class="hero-district">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="hero-pill">
          ⚡ Home of the Little Giants · Purple & Gold Pride
        </div>
        <h1 class="hero-title">
          Empowering Every Student, <span>Every Day.</span>
        </h1>
        <p class="hero-lead">
          Welcome to the modernized Canton Union School District #66. We provide a streamlined, transparent experience for parents, students, and community members with instant access to school portals, calendars, and comprehensive Board of Education policies.
        </p>

        <div class="hero-actions">
          <a href="/policies" class="btn-primary">
            🔍 Search Board Policies
          </a>
          <a href="/parents" class="btn-secondary">
            👨‍👩‍👧 Parent & Student Hub
          </a>
          <a href="/#schools" class="btn-secondary">
            🏫 Explore 5 Schools
          </a>
        </div>
      </div>

      <div>
        <div class="hero-status-card">
          <div class="status-card-header">
            <span style="font-weight: 700; font-size: 0.95rem; color: #FFFFFF;">District Snapshot</span>
            <div class="status-indicator">
              <span class="pulse-dot"></span>
              <span>Schools in Session</span>
            </div>
          </div>

          <div class="status-stat-grid">
            <div class="status-stat-box">
              <div class="status-stat-num">5</div>
              <div class="status-stat-lbl">Community Schools</div>
            </div>
            <div class="status-stat-box">
              <div class="status-stat-num">2,200+</div>
              <div class="status-stat-lbl">Enrolled Students</div>
            </div>
            <div class="status-stat-box">
              <div class="status-stat-num">1:1</div>
              <div class="status-stat-lbl">Chromebook Tech</div>
            </div>
            <div class="status-stat-box">
              <div class="status-stat-num">19</div>
              <div class="status-stat-lbl">IHSA Varsity Sports</div>
            </div>
          </div>

          <div style="background: rgba(255,255,255,0.06); border-radius: var(--radius-sm); padding: 0.85rem; border-left: 3px solid var(--cusd-gold); font-size: 0.8125rem; color: #E9D5FF;">
            <strong style="color: #FFFFFF;">Upcoming Board Meeting:</strong> 3rd Monday of the month at 7:00 PM in the Canton High School Library. Agendas posted 48 hours in advance.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
