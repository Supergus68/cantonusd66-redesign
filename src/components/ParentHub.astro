---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section id="parent-hub" class:list={[{ "is-compact": compact }]} style="padding: 3.5rem 0; background: var(--white); border-top: 1px solid var(--slate-200);">
  <div class="container">
    <div style="text-align: center; max-width: 760px; margin: 0 auto 3rem;">
      <span class="section-badge">Streamlined For Families</span>
      <h2 class="section-heading">Parent & Student Essential Hub</h2>
      <p class="section-sub" style="margin-left: auto; margin-right: auto;">
        No more searching through cluttered menus. Everything you need for your child's daily school life is organized into clear, accessible categories below.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
      <!-- Category 1: Safety & Student Well-Being -->
      <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1.75rem; display: flex; flex-direction: column;">
        <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🛡️</div>
        <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem;">Safety, Well-Being & Health</h3>
        <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1.25rem;">
          Protecting our students is our highest priority. Access reporting tools, health requirements, and counseling contacts.
        </p>

        <ul style="list-style: none; font-size: 0.875rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.65rem;">
          <li>
            <a href="https://www.cantonusd.org/report-bullying.html" target="_blank" rel="noopener" style="color: #DC2626; font-weight: 700; display: flex; align-items: center; gap: 0.4rem;">
              🚨 Report Bullying / Incident Form &rarr;
            </a>
          </li>
          <li>
            <a href="https://www.cantonusd.org/uploads/9/2/4/0/92407718/immunization_district_summary_25-26.pdf" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              📋 State Immunization & Physical Requirements
            </a>
          </li>
          <li>
            <a href="https://www.isbe.net/Documents/Faiths-Law-Resource-Guide.pdf%20" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              ⚖️ Faith's Law & Sexual Abuse Prevention (ISBE)
            </a>
          </li>
          <li>
            <a href="https://www.cantonusd.org/cusd-counselors.html" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              🤝 CUSD Mental Health & Guidance Counselors
            </a>
          </li>
          <li>
            <a href="https://markel.sevencorners.com/" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              🩹 Optional Student Accident Insurance
            </a>
          </li>
        </ul>
      </div>

      <!-- Category 2: Technology & Learning Portals -->
      <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1.75rem; display: flex; flex-direction: column;">
        <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">💻</div>
        <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem;">Digital Learning & 1:1 Tech</h3>
        <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1.25rem;">
          Canton USD #66 equips students with 1:1 Chromebooks and modern digital platforms for classroom success.
        </p>

        <ul style="list-style: none; font-size: 0.875rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.65rem;">
          <li>
            <a href="https://clever.com/in/canton-union-school-dist-66-1c0a4dd" target="_blank" rel="noopener" style="color: #2563EB; font-weight: 700; display: flex; align-items: center; gap: 0.4rem;">
              🔑 Clever Single Sign-On Portal &rarr;
            </a>
          </li>
          <li>
            <a href="/policies#policyQueryInput" style="color: var(--cusd-purple); font-weight: 600;">
              📱 Acceptable Use Policy (Policy 6:235)
            </a>
          </li>
          <li>
            <a href="https://www.cantonusd.org/ims-student-device-expectations.html" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              💼 1:1 Chromebook Device Agreement & Guidelines
            </a>
          </li>
          <li>
            <a href="https://sites.google.com/cusd66.org/cusd66libraries?usp=sharing" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              📚 Elementary & Middle School Library Hub
            </a>
          </li>
          <li>
            <a href="https://global-zone51.renaissance-go.com/welcomeportal/183021%20%20" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              📖 Accelerated Reader (AR) Login
            </a>
          </li>
        </ul>
      </div>

      <!-- Category 3: Meals, Transportation & Registration -->
      <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 1.75rem; display: flex; flex-direction: column;">
        <div style="font-size: 1.75rem; margin-bottom: 0.75rem;">🚌</div>
        <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.5rem;">Enrollment, Food & Busing</h3>
        <p style="font-size: 0.85rem; color: var(--slate-600); margin-bottom: 1.25rem;">
          Key logistical resources for enrollment, daily bus routes, cafeteria menus, and fee assistance.
        </p>

        <ul style="list-style: none; font-size: 0.875rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.65rem;">
          <li>
            <a href="https://www.cantonusd.org/registration-info.html" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 700; display: flex; align-items: center; gap: 0.4rem;">
              📝 Student Registration & Proof of Residency &rarr;
            </a>
          </li>
          <li>
            <a href="https://www.fdmealplanner.com/#menu/mp/CantonUnionSD/" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              🥗 Whitsons Monthly Meal Menus & Nutrition
            </a>
          </li>
          <li>
            <a href="/policies#policyQueryInput" style="color: var(--cusd-purple); font-weight: 600;">
              💳 School Fee Waiver & Free Lunch Policy (4:140)
            </a>
          </li>
          <li>
            <a href="https://www.cantonusd.org/school-locations.html" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              📍 School Locations, Map & Transportation Rules
            </a>
          </li>
          <li>
            <a href="https://www.cantonusd.org/uploads/9/2/4/0/92407718/26-27_cusd66_public_school_calendar_8-17-26_-_5-20-2027.pdf" target="_blank" rel="noopener" style="color: var(--cusd-purple); font-weight: 600;">
              🗓️ 2026–27 School Year Master Calendar (PDF)
            </a>
          </li>
        </ul>
      </div>
    </div>

    {compact && (
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/parents" class="btn-secondary">See all parent & student resources &rarr;</a>
      </div>
    )}
  </div>
</section>

<style>
  .is-compact ul li:nth-child(n + 4) {
    display: none;
  }
</style>
