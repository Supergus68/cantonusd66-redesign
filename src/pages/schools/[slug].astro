---
import Layout from "../../components/Layout.astro";
import { SCHOOLS } from "../../data/schools.js";

export function getStaticPaths() {
  return SCHOOLS.map((school) => ({
    params: { slug: school.slug },
    props: { school },
  }));
}

const { school } = Astro.props;
const [nameLead, ...nameRest] = school.name.split(" ");
const gradesValue = school.grades.replace("Grades ", "");
const primaryLink = school.quickLinks[0];

function describe(label: string, shortName: string) {
  const l = label.toLowerCase();
  if (l.includes("handbook")) return "Rules, expectations, and procedures for the school year.";
  if (l.includes("skyward")) return "Grades, attendance, assignments, and teacher messages.";
  if (l.includes("menu") || l.includes("lunch") || l.includes("breakfast") || l.includes("food")) return "Daily breakfast and lunch nutrition information.";
  if (l.includes("athletic") || l.includes("sports") || l.includes("roster")) return "Schedules, rosters, and Little Giants game information.";
  if (l.includes("registration")) return "Enrollment forms and residency verification.";
  if (l.includes("device") || l.includes("chromebook")) return "1:1 device expectations and agreement details.";
  if (l.includes("bullying")) return "Report a concern confidentially to the district.";
  if (l.includes("counsel")) return "Academic planning, college, and career guidance.";
  if (l.includes("sip") || l.includes("school improvement") || l.includes("plan")) return "School improvement goals and progress reports.";
  if (l.includes("library")) return "Digital library resources and reading tools.";
  if (l.includes("band") || l.includes("music")) return "Ensembles, rehearsals, and performance schedules.";
  if (l.includes("behavior")) return "Expectations and positive behavior supports.";
  if (l.includes("accelerated reader")) return "Reading practice and accelerated reader resources.";
  if (l.includes("kindergarten")) return "Kindergarten enrollment and readiness information.";
  if (l.includes("friends") || l.includes("pto")) return "Parent organization news, events, and volunteer opportunities.";
  return `Quick access to ${label.toLowerCase()} for ${shortName} families.`;
}
---

<Layout
  title={`${school.name} · Canton USD #66`}
  description={`${school.name} (${school.grades}) in Canton Union School District #66. Principal: ${school.principal}. Phone: ${school.phone}. Quick access to handbooks, Skyward, breakfast/lunch menus, and school resources.`}
  currentPath="/schools"
>
  <!-- Hero: same layout and palette as the district home page -->
  <section class="hero-district school-hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <a href="/schools" class="back-link">&larr; All CUSD #66 Schools</a>
          <div class="hero-pill">
            🏫 {school.grades} · {school.mascot} Pride
          </div>
          <h1 class="hero-title">
            {nameLead} <span>{nameRest.join(" ")}</span>
          </h1>
          <p class="hero-lead">
            {school.tagline} Everything {school.shortName} families need — portals, menus, handbooks, and policies — in one clean place.
          </p>

          <div class="hero-actions">
            <a href={primaryLink.url} target="_blank" rel="noopener" class="btn-primary">
              {primaryLink.icon} {primaryLink.label}
            </a>
            <a href="/policies" class="btn-secondary">
              🔍 Board Policies
            </a>
            <a href="/parents" class="btn-secondary">
              👨‍👩‍👧 Parent Hub
            </a>
          </div>

          <div class="school-hero-badges">
            {school.badges.map((badge: string) => (
              <span class="school-badge-item">{badge}</span>
            ))}
          </div>
        </div>

        <div>
          <div class="hero-status-card">
            <div class="status-card-header">
              <span style="font-weight: 700; font-size: 0.95rem; color: #FFFFFF;">{school.shortName} Snapshot</span>
              <div class="status-indicator">
                <span class="pulse-dot"></span>
                <span>Little Giants</span>
              </div>
            </div>

            <div class="status-stat-grid">
              <div class="status-stat-box">
                <div class="status-stat-num">{gradesValue}</div>
                <div class="status-stat-lbl">Grade Levels</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">{school.mascot}</div>
                <div class="status-stat-lbl">Mascot</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">{school.hours}</div>
                <div class="status-stat-lbl">School Day</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">{school.phone}</div>
                <div class="status-stat-lbl">Main Office</div>
              </div>
            </div>

            <div class="snapshot-note">
              <div>👤 <strong>Principal:</strong> {school.principal}</div>
              <div>📍 {school.address}</div>
              <div>📠 <strong>Fax:</strong> {school.fax}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick access: the same card style as the district home page -->
  <section class="quick-access-section school-quick-section">
    <div class="container">
      <div class="section-header-centered">
        <span class="section-badge">Fast Parent Access</span>
        <h2 class="section-heading">Daily Resources for {school.shortName} Families</h2>
        <p class="section-sub">
          One click to the portals, handbooks, menus, and school information parents use most.
        </p>
      </div>

      <div class="quick-cards-grid">
        {school.quickLinks.map((item: { label: string; url: string; icon: string }) => (
          <a href={item.url} target="_blank" rel="noopener" class="quick-card">
            <div class="quick-card-icon">{item.icon}</div>
            <div class="quick-card-title">{item.label}</div>
            <div class="quick-card-desc">{describe(item.label, school.shortName)}</div>
            <div class="quick-card-link">Open Resource &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Highlights: same section and card treatment as the home page -->
  <section class="policy-section school-features-section">
    <div class="container">
      <div class="section-header-centered">
        <span class="section-badge">School Programs & Culture</span>
        <h2 class="section-heading">Excellence at {school.shortName}</h2>
        <p class="section-sub">{school.description}</p>
      </div>

      <div class="policy-grid">
        {school.highlights.map((h: { title: string; desc: string }) => (
          <div class="policy-card highlight-card">
            <div class="policy-card-top">
              <span class="policy-code-badge">✦</span>
              <span class="policy-section-tag">{school.shortName} Highlight</span>
            </div>
            <h3 class="policy-title">{h.title}</h3>
            <p class="policy-summary">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Policy and parent-support callout -->
  <section class="board-section school-policies-banner">
    <div class="container">
      <div class="board-leadership-card policy-cta-box">
        <div class="leadership-tag">District Support</div>
        <h3 class="superintendent-name">Questions about {school.shortName} policies?</h3>
        <p class="superintendent-quote">
          Search the full Board of Education policy database — student conduct (7:190), 1:1 Chromebook rules (6:235), attendance (7:70), bullying reporting, and public comment (2:230).
        </p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/policies" class="btn-primary" style="font-size: 0.875rem;">
            🔍 Search District Policies
          </a>
          <a href="/parents" class="btn-secondary" style="font-size: 0.875rem;">
            👨‍👩‍👧 Parent & Student Hub
          </a>
          <a href="/schools" class="btn-secondary" style="font-size: 0.875rem;">
            🏫 All Schools
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .school-hero {
    padding-bottom: 5.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--cusd-gold);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s;
  }
  .back-link:hover {
    transform: translateX(-3px);
    text-decoration: underline;
  }
  .school-hero .hero-title {
    font-size: 2.5rem;
  }
  .school-hero .status-stat-num {
    font-size: 1.1rem;
    line-height: 1.25;
    word-break: break-word;
  }
  .snapshot-note {
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 0.85rem;
    border-left: 3px solid var(--cusd-gold);
    font-size: 0.8125rem;
    color: #E9D5FF;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .snapshot-note strong {
    color: #FFFFFF;
  }
  .school-hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .school-badge-item {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .section-header-centered {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }
  .school-quick-section .quick-cards-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .school-features-section {
    background: var(--white);
  }
  .highlight-card {
    position: relative;
    overflow: hidden;
  }
  .highlight-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--cusd-purple);
    transition: background 0.2s;
  }
  .highlight-card:hover::before {
    background: var(--cusd-gold);
  }
  .school-policies-banner {
    background: var(--slate-50);
  }
  @media (max-width: 1024px) {
    .school-quick-section .quick-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .school-hero .hero-title {
      font-size: 2rem;
    }
    .school-quick-section .quick-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
