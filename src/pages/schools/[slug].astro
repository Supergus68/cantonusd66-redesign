---
import Layout from "../../components/Layout.astro";
import { SCHOOLS } from "../../data/schools.js";

export function getStaticPaths() {
  return SCHOOLS.map((school) => ({
    params: { slug: school.slug },
    props: { school },
  }));
}

const { school } = Astro.props;
---

<Layout 
  title={`${school.name} · Canton USD #66`} 
  description={`${school.name} (${school.grades}) in Canton Union School District #66. Principal: ${school.principal}. Phone: ${school.phone}. Quick access to handbooks, Skyward, breakfast/lunch menus, and school resources.`}
  currentPath="/schools"
>
  <!-- School Hero Header -->
  <section class="school-hero">
    <div class="container">
      <div class="school-hero-content">
        <a href="/#schools" class="back-link">
          &larr; Back to All CUSD #66 Schools
        </a>
        <div class="school-hero-pill">
          {school.grades} · Mascot: {school.mascot} ({school.colors})
        </div>
        <h1 class="school-hero-title">{school.name}</h1>
        <p class="school-hero-tagline">{school.tagline}</p>
        
        <div class="school-hero-meta">
          <span>👤 <strong>Principal:</strong> {school.principal}</span>
          <span>📍 {school.address}</span>
          <span>📞 <a href={`tel:${school.phone.replace(/[^0-9]/g, '')}`}>{school.phone}</a></span>
          <span>📠 <strong>Fax:</strong> {school.fax}</span>
          <span>⏰ <strong>Hours:</strong> {school.hours}</span>
        </div>

        <div class="school-hero-badges">
          {school.badges.map((badge: string) => (
            <span class="school-badge-item">{badge}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- School Quick Action Portal Grid -->
  <section class="school-quick-section">
    <div class="container">
      <div class="section-header-centered">
        <span class="section-badge">Fast Parent Access</span>
        <h2 class="section-heading">Daily Resources for {school.shortName} Families</h2>
        <p class="section-sub">
          Instant links to family portals, daily lunch menus, handbooks, and direct office services.
        </p>
      </div>

      <div class="school-portal-grid">
        {school.quickLinks.map((item: { label: string; url: string; icon: string }) => (
          <a href={item.url} target="_blank" rel="noopener" class="school-portal-card">
            <div class="portal-card-icon">{item.icon}</div>
            <div class="portal-card-label">{item.label}</div>
            <div class="portal-card-arrow">Open Resource &rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- School Highlights & Curriculum Section -->
  <section class="school-features-section">
    <div class="container">
      <div class="features-wrapper">
        <div class="section-header-left">
          <span class="section-badge">School Programs & Culture</span>
          <h2 class="section-heading">Excellence at {school.shortName}</h2>
          <p class="section-sub">
            {school.description}
          </p>
        </div>

        <div class="features-grid">
          {school.highlights.map((h: { title: string; desc: string }) => (
            <div class="feature-box">
              <h3 class="feature-title">{h.title}</h3>
              <p class="feature-desc">{h.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- District Support & Policies Banner -->
  <section class="school-policies-banner">
    <div class="container">
      <div class="policy-cta-box">
        <div>
          <h3 style="font-size: 1.35rem; font-weight: 800; color: #FFFFFF; margin-bottom: 0.5rem;">
            Have questions about {school.shortName} policies?
          </h3>
          <p style="color: #E9D5FF; font-size: 0.925rem; max-width: 680px; margin: 0;">
            Search our comprehensive Board of Education Policy database for student conduct (7:190), 1:1 Chromebook rules (6:235), attendance policies (7:70), and bullying reporting.
          </p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/policies" class="btn-primary" style="font-size: 0.875rem;">
            🔍 Search District Policies
          </a>
          <a href="/parents" class="btn-secondary" style="font-size: 0.875rem;">
            👨‍👩‍👧 Parent Hub
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .school-hero {
    background: radial-gradient(circle at 80% 20%, rgba(197, 179, 88, 0.22), transparent 45%),
                linear-gradient(135deg, #4A0072 0%, #6A0DAD 50%, #7B1FA2 100%);
    color: #FFFFFF;
    padding: 3.5rem 0 4.5rem;
    border-bottom: 4px solid var(--cusd-gold);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--cusd-gold);
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s;
  }
  .back-link:hover {
    transform: translateX(-3px);
    text-decoration: underline;
  }

  .school-hero-pill {
    display: inline-block;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(197, 179, 88, 0.5);
    color: var(--cusd-gold);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .school-hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .school-hero-tagline {
    font-size: 1.15rem;
    color: #F3E8FF;
    max-width: 720px;
    margin-bottom: 1.75rem;
    line-height: 1.5;
  }

  .school-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    font-size: 0.9rem;
    color: #E9D5FF;
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .school-hero-meta a {
    color: var(--cusd-gold);
    font-weight: 700;
  }

  .school-hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .school-badge-item {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .school-quick-section {
    padding: 4.5rem 0;
    background: var(--white);
    border-bottom: 1px solid var(--slate-200);
  }

  .section-header-centered {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .school-portal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .school-portal-card {
    background: var(--slate-50);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .school-portal-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--cusd-purple);
    transition: background 0.2s;
  }

  .school-portal-card:hover {
    transform: translateY(-3px);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    border-color: var(--cusd-purple-border);
  }

  .school-portal-card:hover::before {
    background: var(--cusd-gold);
  }

  .portal-card-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .portal-card-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--slate-900);
    margin-bottom: 1rem;
    flex-grow: 1;
    line-height: 1.4;
  }

  .portal-card-arrow {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--cusd-purple);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .school-portal-card:hover .portal-card-arrow {
    color: var(--cusd-gold-dark);
  }

  .school-features-section {
    padding: 4.5rem 0;
    background: var(--slate-50);
    border-bottom: 1px solid var(--slate-200);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .feature-box {
    background: var(--white);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .feature-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--slate-900);
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    font-size: 0.9rem;
    color: var(--slate-600);
    line-height: 1.6;
  }

  .school-policies-banner {
    padding: 3rem 0;
    background: var(--white);
  }

  .policy-cta-box {
    background: linear-gradient(135deg, var(--cusd-purple-deep), var(--cusd-purple));
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 900px) {
    .school-portal-grid {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
    .policy-cta-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
