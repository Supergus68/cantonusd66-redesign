---
import Layout from "../../components/Layout.astro";
import QuickAccess from "../../components/QuickAccess.astro";
import { SCHOOLS } from "../../data/schools.js";
---

<Layout
  title="Our Community Schools · Canton Union School District #66"
  description="Explore the five schools of Canton Union School District #66: Canton High School, Ingersoll Middle School, Eastview Elementary, Lincoln Elementary, and Westview Elementary."
  currentPath="/schools"
>
  <!-- Hero: same layout and palette as the district home page -->
  <section class="hero-district">
    <div class="container">
      <div class="hero-grid">
        <div>
          <div class="hero-pill">🏫 Five Schools · One District</div>
          <h1 class="hero-title">Find Your <span>School</span></h1>
          <p class="hero-lead">
            Canton Union School District #66 serves over 2,200 students across five distinctive schools. Open a school below for bell schedules, principal contacts, daily resources, and handbooks.
          </p>
          <div class="hero-actions">
            <a href="/parents" class="btn-primary">
              👨‍👩‍👧 Parent & Student Hub
            </a>
            <a href="/policies" class="btn-secondary">
              🔍 Board Policies
            </a>
          </div>
        </div>

        <div>
          <div class="hero-status-card">
            <div class="status-card-header">
              <span style="font-weight: 700; font-size: 0.95rem; color: #FFFFFF;">District Snapshot</span>
              <div class="status-indicator">
                <span class="pulse-dot"></span>
                <span>Schools in Session</span>
              </div>
            </div>

            <div class="status-stat-grid">
              <div class="status-stat-box">
                <div class="status-stat-num">5</div>
                <div class="status-stat-lbl">Community Schools</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">2,200+</div>
                <div class="status-stat-lbl">Enrolled Students</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">1:1</div>
                <div class="status-stat-lbl">Chromebook Tech</div>
              </div>
              <div class="status-stat-box">
                <div class="status-stat-num">19</div>
                <div class="status-stat-lbl">IHSA Varsity Sports</div>
              </div>
            </div>

            <div class="snapshot-note">
              <strong style="color: #FFFFFF;">Not sure where to start?</strong> The Parent Hub has registration, menus, calendars, and bullying reporting in one place.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <QuickAccess />

  <section class="schools-section">
    <div class="container">
      <div class="section-header-centered">
        <span class="section-badge">District 66 Campuses</span>
        <h2 class="section-heading">Our Community Schools</h2>
        <p class="section-sub">
          Five schools, one Little Giants family. Each page has its own principal, bell hours, resources, and quick links.
        </p>
      </div>

      <div class="schools-grid">
        {SCHOOLS.map((school) => (
          <article class="school-card">
            <div>
              <span class="school-badge">{school.grades}</span>
              <h2 class="school-title">
                <a href={`/schools/${school.slug}`} style="color: inherit;">
                  {school.name}
                </a>
              </h2>
              <div class="school-grades">Mascot: {school.mascot} ({school.colors})</div>
            </div>

            <p class="school-card-desc">{school.description}</p>

            <ul class="school-meta-list">
              <li class="school-meta-item">
                <span>👤</span>
                <span><strong>Principal:</strong> {school.principal}</span>
              </li>
              <li class="school-meta-item">
                <span>📍</span>
                <span>{school.address}</span>
              </li>
              <li class="school-meta-item">
                <span>📞</span>
                <a href={`tel:${school.phone.replace(/[^0-9]/g, '')}`} style="color: var(--cusd-purple); font-weight: 600;">
                  {school.phone}
                </a>
              </li>
              <li class="school-meta-item">
                <span>⏰</span>
                <span><strong>Hours:</strong> {school.hours}</span>
              </li>
            </ul>

            <div class="school-tags">
              {school.badges.map((tag) => (
                <span class="school-tag">{tag}</span>
              ))}
            </div>

            <div class="school-actions">
              <a href={`/schools/${school.slug}`} class="btn-primary" style="font-size: 0.8125rem; padding: 0.45rem 0.9rem;">
                Visit {school.shortName} Portal &rarr;
              </a>
              <a href={school.handbookUrl} target="_blank" rel="noopener" class="btn-policy-ext" style="font-size: 0.8125rem;">
                Handbook ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-header-centered {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }
  .snapshot-note {
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 0.85rem;
    border-left: 3px solid var(--cusd-gold);
    font-size: 0.8125rem;
    color: #E9D5FF;
    line-height: 1.6;
  }
  .school-card-desc {
    font-size: 0.875rem;
    color: var(--slate-600);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
</style>
